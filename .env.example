# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_TOKEN=           # Bearer token de Meta (Graph API)
WHATSAPP_PHONE_NUMBER_ID= # ID del número en Meta Business Manager
WHATSAPP_VERIFY_TOKEN=    # Token propio para validar webhook

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=        # sk-ant-...

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=          # APP_USR-...
MP_NOTIFICATION_URL=      # URL pública del webhook de notificaciones MP

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── App ───────────────────────────────────────────────────────────────────────
ENV=development           # development | production
SKU_CSV_PATH=data/catalogo_sku_ami.csv
LOG_LEVEL=INFO

# ── Radar (solo con APP_MODE=radar; ver docs/radar-despliegue.md) ────────────
# (Una variable vacía lleva su comentario en la línea de arriba: python-dotenv
# leería "VAR=   # texto" como el valor "# texto".)
APP_MODE=bot
# Host de uvicorn, lo lee el CMD del Dockerfile. Vacía = 0.0.0.0; :: para IPv6
# (red privada de Railway).
UVICORN_HOST=
RADAR_MIGRATOR_DATABASE_URL=
RADAR_DATABASE_URL=
RADAR_BOOTSTRAP_ROLES=false  # true: el arranque crea radar_admin y radar_app si faltan (sin psql)
RADAR_FUENTE_DATABASE_URL=
RADAR_SECRETS_DIR=/data/radar-secrets
RADAR_COOKIE_SECRET=
RADAR_PUBLIC_BASE_URL=
# Emails separados por coma: admins de KIS que crea el arranque (no les manda nada).
RADAR_ADMINS_INICIALES=

# ── Radar: email ─────────────────────────────────────────────────────────────
RADAR_MAILER=log          # log (no manda nada) | smtp (manda de verdad) | memoria (tests)
RADAR_REMITENTE=radar@keepitsimple.com.ar
# SMTP, con RADAR_MAILER=smtp. Host: solo el nombre (ej. smtp.gmail.com). Usuario
# vacío = sin autenticar (relay de una red privada). Contraseña: de aplicación o
# clave SMTP del proveedor; nunca en el repo.
RADAR_SMTP_HOST=
RADAR_SMTP_PORT=587       # 465 con RADAR_SMTP_SEGURIDAD=ssl
RADAR_SMTP_USUARIO=
RADAR_SMTP_PASSWORD=
RADAR_SMTP_SEGURIDAD=starttls  # starttls | ssl | ninguna
RADAR_SMTP_TIMEOUT_S=20

# ── Radar tramo 2 (WAHA) ─────────────────────────────────────────────────────
RADAR_WAHA_WEBHOOK_URL=
RADAR_WAHA_WEBHOOK_HMAC_KEY=
RADAR_WAHA_TIMEOUT_S=20
RADAR_WORKER_EMBEBIDO=true
