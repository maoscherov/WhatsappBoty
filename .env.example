# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_TOKEN=           # Bearer token de Meta (Graph API)
WHATSAPP_PHONE_NUMBER_ID= # ID del número en Meta Business Manager
WHATSAPP_VERIFY_TOKEN=    # Token propio para validar webhook

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=        # sk-ant-...

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=          # APP_USR-...
MP_NOTIFICATION_URL=      # URL pública del webhook de notificaciones MP

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── App ───────────────────────────────────────────────────────────────────────
ENV=development           # development | production
SKU_CSV_PATH=data/catalogo_sku_ami.csv
LOG_LEVEL=INFO

# ── Radar (solo con APP_MODE=radar; ver docs/radar-despliegue.md) ────────────
APP_MODE=bot
RADAR_MIGRATOR_DATABASE_URL=
RADAR_DATABASE_URL=
RADAR_FUENTE_DATABASE_URL=
RADAR_SECRETS_DIR=/data/radar-secrets
RADAR_COOKIE_SECRET=
RADAR_PUBLIC_BASE_URL=
RADAR_MAILER=log
